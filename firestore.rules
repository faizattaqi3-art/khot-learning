rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isTeacher() {
      return signedIn() && userDoc().data.role == 'teacher';
    }
    function isStudent() {
      return signedIn() && userDoc().data.role == 'student';
    }
    function classTeacher(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    function assignedTo(classId) {
      return isTeacher() && (
        (('assignedClasses' in userDoc().data) && userDoc().data.assignedClasses.hasAny([classId]))
        || classTeacher(classId)
      );
    }
    function canManageClassContent(data) {
      return isAdmin() || (isTeacher() && ('classId' in data) && assignedTo(data.classId));
    }
    function submissionData(submissionId) {
      return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
    }
    function canReviewSubmission(submissionId) {
      return isAdmin() || assignedTo(submissionData(submissionId).classId);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'classCode', 'classId', 'createdAt', 'updatedAt']);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (isTeacher() && ('classId' in resource.data) && resource.data.classId != null && assignedTo(resource.data.classId)));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAdmin() || resource.data.teacherId == request.auth.uid || assignedTo(classId)
        || (isStudent() && userDoc().data.classId == classId);
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || resource.data.teacherId == request.auth.uid || assignedTo(classId);
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid)
        || assignedTo(resource.data.classId);
      allow create: if isAdmin() || (isStudent() && request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin() || assignedTo(resource.data.classId);
    }

    match /levels/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }
    match /categories/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }
    match /lessons/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }
    match /assignments/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }

    match /submissions/{submissionId} {
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId == userDoc().data.classId
        && request.resource.data.status == 'Submitted'
        && request.resource.data.score == null;
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || assignedTo(resource.data.classId);
      allow update: if isAdmin() || (assignedTo(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /assessments/{submissionId} {
      allow read: if isAdmin()
        || (signedIn() && submissionData(submissionId).studentId == request.auth.uid)
        || canReviewSubmission(submissionId);
      allow create, update: if canReviewSubmission(submissionId);
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || assignedTo(resource.data.classId);
      allow create, update: if isAdmin()
        || (isStudent() && request.resource.data.studentId == request.auth.uid)
        || assignedTo(request.resource.data.classId);
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if canManageClassContent(request.resource.data);
      allow update, delete: if canManageClassContent(resource.data);
    }
  }
}
